{
  "manifest_version": 3,
  "name": "Manipulator",
  "version": "0.1.296",
  "description": "See the attention-extraction score of every tweet in your For You feed.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/page-world.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "content/heuristics.js",
        "content/income.js",
        "content/profile-location.js",
        "content/reputation.js",
        "content/tweet-extractor.js",
        "content/score.js",
        "content/content.js"
      ],
      "css": ["content/badge.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
